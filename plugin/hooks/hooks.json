{
  "description": "trellis plugin hooks. SessionStart injects board state and agent identity; UserPromptSubmit recalls refs bearing on the prompt; Stop reminds about claimed cards with no comment. Hook code lives in integrations/, one directory per harness.",
  "hooks": {
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"${CLAUDE_PLUGIN_ROOT}/integrations/claude_code/recall.py\"",
            "timeout": 10
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "matcher": "startup|resume|clear|compact|fork",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"${CLAUDE_PLUGIN_ROOT}/hooks/trellis_hook.py\" session-start",
            "timeout": 10
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"${CLAUDE_PLUGIN_ROOT}/hooks/trellis_hook.py\" stop",
            "timeout": 10
          }
        ]
      }
    ]
  }
}
