{
  "description": "trellis plugin hooks. SessionStart writes TRELLIS_SESSION and injects the board brief from `trellis call board_brief`; UserPromptSubmit adds the entries `trellis call recall` finds; Stop reminds about claimed cards with no comment and entries not nominated, from `trellis call remind`. band.tsx draws the review queue above the prompt.",
  "hooks": {
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"${CLAUDE_PLUGIN_ROOT}/integrations/claude_code/recall.py\"",
            "timeout": 10
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "matcher": "startup|resume|clear|compact|fork",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"${CLAUDE_PLUGIN_ROOT}/hooks/trellis_hook.py\" session-start",
            "timeout": 10
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"${CLAUDE_PLUGIN_ROOT}/hooks/trellis_hook.py\" stop",
            "timeout": 10
          }
        ]
      }
    ]
  },
  "modules": [
    "./band.tsx"
  ]
}
