{
  "description": "sdd hooks. PostToolUse checks a written migration against every branch and queues unanswered AskUserQuestion questions; Stop and SessionEnd queue the Qn. questions of the last reply and any declined AskUserQuestion found in the transcript; SessionStart prints one line when open items wait. None runs the test suite.",
  "hooks": {
    "SessionStart": [
      {
        "matcher": "startup|resume|clear|compact",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"${CLAUDE_PLUGIN_ROOT}/hooks/sdd_hook.py\" session-start",
            "timeout": 15
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Write|Edit|MultiEdit|AskUserQuestion",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"${CLAUDE_PLUGIN_ROOT}/hooks/sdd_hook.py\" post-tool",
            "timeout": 15
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"${CLAUDE_PLUGIN_ROOT}/hooks/sdd_hook.py\" stop",
            "timeout": 15
          }
        ]
      }
    ],
    "SessionEnd": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"${CLAUDE_PLUGIN_ROOT}/hooks/sdd_hook.py\" session-end",
            "timeout": 15
          }
        ]
      }
    ]
  }
}
